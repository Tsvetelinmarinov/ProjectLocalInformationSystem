@model ParkViewModel

@{
    this.ViewData["Title"] = $"Park {this.Model.Name}";
}

<div class="container py-4">
    <!-- Navigation -->
    <partial name="ParkDetails/_ParkDetailsPageNavigationPartial" model="@this.Model" />
    <!-- Header -->
    <partial name="ParkDetails/_ParkDetailsPageHeaderPartial" model="@this.Model" />
    <!-- StatisticCards -->
    <partial name="ParkDetails/_ParkDetailsPageStatisticCardsPartial" model="@this.Model" />
</div>

@section Design {
    <link rel="stylesheet" fref="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
}