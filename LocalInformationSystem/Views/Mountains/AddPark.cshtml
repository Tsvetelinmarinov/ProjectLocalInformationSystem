@model ParkViewModel

@{
    ViewData["Title"] = "Add Park";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Forms CSS -->
    <link href="~/css/forms.css" rel="stylesheet" />
</head>
<body>
<div class="form-container">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="form-card">
                    <div class="form-header">
                        <h2>
                            <i class="bi bi-plus-circle-fill"></i>
                            Add New Park
                        </h2>
                    </div>

                    <div class="form-content">
                        <form asp-action="AddPark" method="post" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- Name Field -->
                            <div class="form-group">
                                <label asp-for="Name" class="form-label">
                                    <i class="bi bi-tree me-2 text-primary"></i>Park Name
                                </label>
                                <input asp-for="Name" class="form-control" placeholder="Enter park name (e.g., Rila National Park)" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <!-- Type Field -->
                            <div class="form-group">
                                <label asp-for="Type" class="form-label">
                                    <i class="bi bi-tag me-2 text-primary"></i>Park Type
                                </label>
                                <input asp-for="Type" class="form-control" placeholder="Enter park type (e.g., National Park, Nature Reserve)" />
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>

                            <!-- Area Field -->
                            <div class="form-group">
                                <label asp-for="AreaSqKm" class="form-label">
                                    <i class="bi bi-map me-2 text-primary"></i>Area (sq km)
                                </label>
                                <input asp-for="AreaSqKm" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" />
                                <span asp-validation-for="AreaSqKm" class="text-danger"></span>
                            </div>

                            <!-- Established Year Field -->
                            <div class="form-group">
                                <label asp-for="EstablishedYear" class="form-label">
                                    <i class="bi bi-calendar-event me-2 text-primary"></i>Established Year
                                </label>
                                <input asp-for="EstablishedYear" type="number" min="1700" max="2100" class="form-control" placeholder="e.g., 1949" />
                                <span asp-validation-for="EstablishedYear" class="text-danger"></span>
                                <small class="form-text">Year range: 1700 - 2100</small>
                            </div>

                            <!-- Mountain Field -->
                            <div class="form-group">
                                <label asp-for="MountainId" class="form-label">
                                    <i class="bi bi-mountain2 me-2 text-primary"></i>Mountain
                                </label>
                                <select asp-for="MountainId" class="form-select">
                                    <option value="">-- Select a Mountain --</option>
                                    @foreach (var mountain in ViewBag.Mountains)
                                    {
                                        <option value="@mountain.MountainId">@mountain.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="MountainId" class="text-danger"></span>
                            </div>

                            <!-- UNESCO Field -->
                            <div class="form-group">
                                <div class="form-check">
                                    <input asp-for="UnescoSite" type="checkbox" class="form-check-input" id="unescoCheck" />
                                    <label class="form-check-label" for="unescoCheck">
                                        <i class="bi bi-globe me-2 text-primary"></i>
                                        Is UNESCO World Heritage Site?
                                    </label>
                                </div>
                                <span asp-validation-for="UnescoSite" class="text-danger"></span>
                            </div>

                            <!-- Buttons -->
                            <div class="button-group">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-2"></i>Add Park
                                </button>
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-2"></i>Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Validation Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>