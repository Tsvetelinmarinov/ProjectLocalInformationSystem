@model ProvinceViewModel

@{
    this.ViewData["Title"] = "Province Information";
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Provinces</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-gradient text-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <span class="badge bg-white text-primary mb-2 px-3 py-2 rounded-pill fs-6 fw-semibold">Province</span>
                    <h1 class="display-4 fw-bold mb-0">@Model.Name</h1>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="" asp-route-id="" class="btn btn-light rounded-pill px-4 shadow-sm fw-medium">
                        <i class="bi bi-pencil me-1"></i> Edit
                    </a>
                    <a asp-controller="Province" asp-action="Index" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Metrics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                        <i class="bi bi-geo-alt fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Administrative Center</div>
                        <div class="fs-4 fw-bold text-dark">@Model.AdministrativeCenter</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                        <i class="bi bi-aspect-ratio fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Area</div>
                        <div class="fs-4 fw-bold text-dark">
                            @(Model.AreaSqKm.HasValue ? $"{Model.AreaSqKm.Value:N2} sq km" : "N/A")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-semibold">Population</div>
                        <div class="fs-4 fw-bold text-dark">
                            @(Model.Population.HasValue ? $"{Model.Population.Value:N0}" : "N/A")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cities List Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-building me-2 text-primary"></i>Cities & Settlements
            </h5>
            <span class="badge bg-secondary rounded-pill px-3 py-2">Total: @Model.Cities.Count</span>
        </div>

        @if (Model.Cities != null && Model.Cities.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-4">City Name</th>
                            <th scope="col" class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var city in Model.Cities)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    <i class="bi bi-dot text-primary fs-4 me-1"></i>
                                    @city.Name
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="City" asp-action="Details" asp-route-id="@city.CityId" class="btn btn-sm btn-light rounded-pill border px-3">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="card-body text-center py-5">
                <i class="bi bi-building-x fs-1 text-muted d-block mb-2"></i>
                <p class="text-muted mb-0">No settlements found for this province.</p>
            </div>
        }
    </div>
</div>