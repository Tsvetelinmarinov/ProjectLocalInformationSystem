@model IEnumerable<ProvinceViewModel>

@{
    ViewData["Title"] = "Provinces";
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="fw-bold text-primary mb-1">
                <i class="bi bi-map-fill me-2"></i>Provinces
            </h1>
            <p class="text-muted mb-0">Overview of provinces and administrative details</p>
        </div>
    </div>

    <!-- Summary / Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h6 class="card-title mb-0 text-white-50">Total Provinces</h6>
                        <h2 class="fw-bold mb-0">@Model.Count()</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="card-title mb-0 text-white-50">Total Population</h6>
                        <h2 class="fw-bold mb-0">@(Model.Sum(p => p.Population ?? 0).ToString("N0"))</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                        <i class="bi bi-aspect-ratio fs-3"></i>
                    </div>
                    <div>
                        <h6 class="card-title mb-0 text-white-50">Total Area</h6>
                        <h2 class="fw-bold mb-0">@(Model.Sum(p => p.AreaSqKm ?? 0).ToString("N2")) sq km</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Data Table -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light border-bottom">
                        <tr>
                            <th scope="col" class="ps-4 py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.ProvinceId)
                            </th>
                            <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.AdministrativeCenter)
                            </th>
                            <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.AreaSqKm)
                            </th>
                            <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.Population)
                            </th>
                            <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                                @Html.DisplayNameFor(model => model.Cities)
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No provinces found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">
                                        @Html.DisplayFor(modelItem => item.ProvinceId)
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i>
                                            @Html.DisplayFor(modelItem => item.AdministrativeCenter)
                                        </span>
                                    </td>
                                    <td>
                                        @(item.AreaSqKm.HasValue ? item.AreaSqKm.Value.ToString("N2") + " km²" : "N/A")
                                    </td>
                                    <td>
                                        @(item.Population.HasValue ? item.Population.Value.ToString("N0") : "N/A")
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-3">
                                            @(item.Cities?.Count ?? 0) cities
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}