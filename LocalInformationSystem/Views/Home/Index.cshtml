@{
    ViewData["Title"] = "Начало";
}

<!-- Custom CSS за Hero секцията -->
<link rel="stylesheet" href="~/css/homePage.css"/>

<!-- Hero Section -->
<div class="hero-section">
    <div class="container py-5">
        <div class="row align-items-center justify-content-between g-5">
            
            <!-- Лява колона: Основно послание -->
            <div class="col-lg-7">
                <span class="badge bg-danger text-uppercase px-3 py-2 mb-3 rounded-pill">
                    Explore Bulgaria
                </span>
                
                <h1 class="hero-title mb-4">
                    Learn the history of <span class="text-warning">Bulgaria</span>
                </h1>
                
                <p class="hero-subtitle mb-4">
                    Explore all the cities, mountains, rivers, parks, regions, and history events.
                </p>
            </div>

            <!-- Дясна колона: Модерни информационни карета (Glassmorphic Cards) -->
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-3">
                    
                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fs-1 text-warning">
                                <i class="bi bi-building-check"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1 fw-bold">28 Regions & 30 Towns</h3>
                                <p class="mb-0 text-white-50 small">Complete geography information.</p>
                            </div>
                        </div>
                    </div>

                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fs-1 text-info">
                                <i class="bi bi-tree"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1 fw-bold">Mountains & Parks</h3>
                                <p class="mb-0 text-white-50 small">Top peaks and parks across the country.</p>
                            </div>
                        </div>
                    </div>

                    <div class="glass-card p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fs-1 text-danger">
                                <i class="bi bi-journal-bookmark"></i>
                            </div>
                            <div>
                                <h3 class="h5 mb-1 fw-bold">History & UNESCO</h3>
                                <p class="mb-0 text-white-50 small">Key events from the history and protected palces and objects.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>