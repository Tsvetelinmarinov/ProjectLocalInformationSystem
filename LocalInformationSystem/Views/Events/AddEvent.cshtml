@model HistoricalEventViewModel

@{
    ViewData["Title"] = "Add Historical Event";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="mb-4 text-center">
                        <h2 class="fw-bold text-dark">New Event</h2>
                        <p class="text-muted">Enter the details for the historical event</p>
                    </div>

                    <form asp-action="AddEvent" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <!-- Event Year -->
                        <div class="form-floating mb-3">
                            <input asp-for="EventYear" class="form-control rounded-3" placeholder="" />
                            <label asp-for="EventYear" class="text-muted">Year</label>
                            <span asp-validation-for="EventYear" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Title -->
                        <div class="form-floating mb-3">
                            <input asp-for="Title" class="form-control rounded-3" placeholder="" />
                            <label asp-for="Title" class="text-muted">Title</label>
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label text-muted fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="4" placeholder="Enter description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light rounded-3 px-4 py-2 text-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">Save Event</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}