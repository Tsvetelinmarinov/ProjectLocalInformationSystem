@model HistoricalEventViewModel

@{
    ViewData["Title"] = $"Edit Event {this.Model.Title}";
}

<div class="min-h-screen bg-slate-950 text-slate-100 flex items-center justify-center px-4 py-12 relative overflow-hidden">
    <!-- Декоративни светещи фонови градиенти (Glow effects) -->
    <div class="absolute -top-32 -right-32 w-96 h-96 bg-indigo-600/20 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-violet-600/20 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-xl w-full bg-slate-900/60 backdrop-blur-2xl border border-slate-800/80 rounded-3xl shadow-2xl shadow-indigo-950/40 p-8 sm:p-10 relative z-10">

        <!-- Заглавна част на формуляра -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 mb-4 shadow-inner">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">@this.Model.Title</h2>
            <p class="text-sm text-slate-400 mt-2">Fill the required fields and click Save Changes</p>
        </div>

        <form asp-action="EditEvent" method="post" class="space-y-6">
            <!-- Валидационен обобщен блок -->
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-medium"></div>

            <!-- Скрит идентификатор -->
            <input type="hidden" asp-for="EventId" />

            <!-- Поле: Година на събитието -->
            <div class="space-y-2">
                <label asp-for="EventYear" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Event Year</label>
                <div class="relative">
                    <input asp-for="EventYear" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm shadow-sm" placeholder="напр. 1878" />
                </div>
                <span asp-validation-for="EventYear" class="block text-xs text-red-400 font-medium mt-1"></span>
            </div>

            <!-- Поле: Заглавие -->
            <div class="space-y-2">
                <div class="flex justify-between items-center">
                    <label asp-for="Title" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Title</label>
                    <span class="text-[11px] text-indigo-400 font-medium">With uppercase letter</span>
                </div>
                <div class="relative">
                    <input asp-for="Title" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm shadow-sm uppercase" placeholder="напр. ОСВОБОЖДЕНИЕТО НА БЪЛГАРИЯ" />
                </div>
                <span asp-validation-for="Title" class="block text-xs text-red-400 font-medium mt-1"></span>
            </div>

            <!-- Поле: Описание (Опционално) -->
            <div class="space-y-2">
                <label asp-for="Description" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">
                    Description <span class="text-slate-500 font-normal lowercase">(optional)</span>
                </label>
                <div class="relative">
                    <textarea asp-for="Description" rows="4" class="w-full bg-slate-900/80 border border-slate-700/80 rounded-xl px-4 py-3.5 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 text-sm shadow-sm resize-none" placeholder="Въведете детайлно описание на историческото събитие..."></textarea>
                </div>
                <span asp-validation-for="Description" class="block text-xs text-red-400 font-medium mt-1"></span>
            </div>

            <!-- Бутони за действие -->
            <div class="flex items-center justify-end space-x-4 pt-4 border-t border-slate-800/80">
                <a asp-action="Index" class="px-5 py-3 rounded-xl border border-slate-700/80 text-slate-300 hover:bg-slate-800 hover:text-white transition-all duration-200 text-sm font-medium">
                    Cancel
                </a>
                <button type="submit" class="px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white font-medium text-sm shadow-lg shadow-indigo-600/25 hover:shadow-indigo-600/40 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 focus:ring-offset-slate-950 transition-all duration-200">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}