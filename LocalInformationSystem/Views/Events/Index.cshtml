@model IEnumerable<HistoricalEventViewModel>

@{
    ViewData["Title"] = "Historical Events";
}

<div class="container py-4">
    <!-- Header and Add Button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Historical Events</h2>
            <p class="text-muted mb-0">List of all events entered in the system</p>
        </div>
        <a asp-action="AddEvent" class="btn btn-primary btn-lg shadow-sm rounded-pill px-4">
            <i class="fa-solid fa-plus me-2"></i><span class="fw-bold">Add New Event</span>
        </a>
    </div>

    <!-- Table Container -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th scope="col" class="ps-4 py-3 border-bottom-0">Year</th>
                        <th scope="col" class="py-3 border-bottom-0">Title</th>
                        <th scope="col" class="py-3 border-bottom-0 w-50">Description</th>
                        <th scope="col" class="pe-4 py-3 border-bottom-0 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="badge bg-secondary text-white rounded-pill px-3 py-2 fs-6">
                                        @item.EventYear
                                    </span>
                                </td>
                                <td class="py-3 fw-semibold text-dark">
                                    @item.Title
                                </td>
                                <td class="py-3 text-muted">
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <span class="d-inline-block" style="max-width: 550px;" title="@item.Description">
                                            @item.Description
                                        </span>
                                    }
                                    else
                                    {
                                        <em class="text-black-50">No description provided</em>
                                    }
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group shadow-sm rounded-pill" role="group">
                                        <a asp-action="EditEvent" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary px-3 rounded-start-pill">
                                            <i class="fa-solid fa-pen me-1"></i> Edit
                                        </a>
                                        <a asp-action="DeleteEvent" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-danger px-3 rounded-end-pill">
                                            <i class="fa-solid fa-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="text-muted">
                                    <!-- Голяма икона за празно състояние -->
                                    <i class="fa-regular fa-folder-open fa-3x mb-3 text-secondary"></i>
                                    <h5 class="fw-light">No events added yet.</h5>
                                    <p class="mb-0">Click the "Add New Event" button to get started.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>