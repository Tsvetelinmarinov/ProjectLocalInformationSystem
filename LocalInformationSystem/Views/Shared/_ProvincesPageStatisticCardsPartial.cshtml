@model IEnumerable<ProvinceViewModel>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-primary text-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="bi bi-building fs-3"></i>
                </div>
                <div>
                    <h6 class="card-title mb-0 text-white-50">Total Provinces</h6>
                    <h2 class="fw-bold mb-0">@Model.Count()</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-success text-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <div>
                    <h6 class="card-title mb-0 text-white-50">Total Population</h6>
                    <h2 class="fw-bold mb-0">@(Model.Sum(p => p.Population ?? 0).ToString("N0"))</h2>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-3 bg-info text-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-white bg-opacity-25 p-3 me-3">
                    <i class="bi bi-aspect-ratio fs-3"></i>
                </div>
                <div>
                    <h6 class="card-title mb-0 text-white-50">Total Area</h6>
                    <h2 class="fw-bold mb-0">@(Model.Sum(p => p.AreaSqKm ?? 0).ToString("N2")) sq km</h2>
                </div>
            </div>
        </div>
    </div>
</div>