<!-- No model -->

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 text-dark fw-bold">Provinces</h5>
    <div class="dropdown">
        <button class="btn btn-light border dropdown-toggle d-flex align-items-center gap-2 shadow-sm" type="button" aria-expanded="false" data-bs-toggle="dropdown">
            <i class="bi bi-sort-down text-secondary"></i>
            <span>Sort</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 py-">
            <li><h6 class="dropdown-header text-uppercase fs-8 text-muted">Sort by</h6></li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Province" asp-action="Index" asp-route-sortingKeyword="name_asc">
                    <i class="bi bi-sort-alpha-down me-2 text-muted"></i> Name (A-Z)
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Province" asp-action="Index" asp-route-sortingKeyword="name_desc">
                    <i class="bi bi-sort-alpha-up-alt me-2 text-muted"></i> Name (Z-A)
                </a>
            </li>
            <li>
                <hr class="dropdown-divider" />
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Province" asp-action="Index" asp-route-sortingKeyword="pop_asc">
                    <i class="bi bi-sort-numeric-down me-2 text-muted"></i>Population (Ascending)
                </a>
            </li>
            <li>
                <a class="dropdown-item py-2" asp-controller="Province" asp-action="Index" asp-route-sortingKeyword="pop_desc">
                    <i class="bi bi-sort-numeric-up-alt me-2 text-muted"></i>Population (Descending)
                </a>
            </li>
        </ul>
    </div>
</div>