@model CityViewModel

<form asp-controller="Cities" asp-action="EditCity" method="post">
    <div class="card-body p-4">

        <!-- Hidden Field for ID -->
        <input type="hidden" asp-for="CityId" />

        <div class="row g-3">
            <!-- City Name -->
            <div class="col-md-6">
                <label asp-for="Name" class="form-label fw-semibold">City Name</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-geo"></i></span>
                    <input asp-for="Name" class="form-control" placeholder="Enter city name" />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <!-- Province ID -->
            <div class="col-md-6">
                <label asp-for="ProvinceId" class="form-label fw-semibold">Province</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-building"></i></span>
                    <input asp-for="ProvinceId" type="number" class="form-control" placeholder="Enter province ID" />
                </div>
                <span asp-validation-for="ProvinceId" class="text-danger small"></span>
            </div>

            <!-- Elevation (Meters) -->
            <div class="col-md-6">
                <label asp-for="ElevationMeters" class="form-label fw-semibold">Elevation (meters)</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-arrow-up-circle"></i></span>
                    <input asp-for="ElevationMeters" type="number" class="form-control" placeholder="e.g. 550" />
                </div>
                <span asp-validation-for="ElevationMeters" class="text-danger small"></span>
            </div>

            <!-- Population -->
            <div class="col-md-6">
                <label asp-for="Population" class="form-label fw-semibold">Population</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-people"></i></span>
                    <input asp-for="Population" type="number" class="form-control" placeholder="e.g. 120000" />
                </div>
                <span asp-validation-for="Population" class="text-danger small"></span>
            </div>

            <!-- Is Capital (Checkbox) -->
            <div class="col-12 mt-3">
                <div class="form-check">
                    <input asp-for="IsCapital" class="form-check-input" type="checkbox" id="IsCapital">
                    <label class="form-check-label fw-semibold" for="IsCapital">
                        Is Capital City
                    </label>
                </div>
                <span asp-validation-for="IsCapital" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <!-- Card Footer Actions -->
    <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top-0 rounded-bottom-4">
        <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-check-lg me-1"></i> Save Changes
        </button>
    </div>
</form>