@model ParkViewModel

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary bg-gradient text-white">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-white text-primary mb-2 px-3 py-2 rounded-pill fs-6 fw-semibold">Landmark</span>
                <h1 class="display-4 fw-bold mb-0">@Model.Name</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="" asp-action="" asp-route-id="" class="btn btn-light rounded-pill px-4 shadow-sm fw-medium">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
                <a asp-controller="Mountains" asp-action="ConcreteMountain" asp-route-id="@Model.MountainId" class="btn btn-outline-light rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>
        </div>
    </div>
</div>