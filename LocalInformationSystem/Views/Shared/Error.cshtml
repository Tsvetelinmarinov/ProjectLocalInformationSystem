@{
    ViewData["Title"] = "Възникна грешка";
}

<!-- Style -->
<link rel="stylesheet" href="~/css/errorPage.css"/>

<div class="container error-wrapper">
    <div class="error-card mx-auto">
        
        <!-- Анимиран символ / Икона -->
        <div class="icon-container">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>

        <div class="error-code mb-2">Error</div>
        
        <h1 class="h2 fw-bold text-dark mb-3">
            Oops! Something happend ...
        </h1>

        <p class="text-secondary mb-4 fs-6">
            Internal Server error! Something went wrong with the server!
        </p>

        <!-- Бутони за действие -->
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-house-door me-2"></i> Back To Home
            </a>
        </div>
    </div>
</div>