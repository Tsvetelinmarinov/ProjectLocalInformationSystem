@model IEnumerable<CityViewModel>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Province</th>
                        <th>Population</th>
                        <th>Elevation</th>
                        <th class="text-center">Is Capital</th>
                        <th class="text-center">Landmarks</th>
                        <th class="text-center"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                No city records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var city in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@city.Name</td>
                                <td>@(city.Province?.Name ?? "-")</td>
                                <td>@(city.Population.HasValue ? city.Population.Value.ToString("N0") : "-")</td>
                                <td>@(city.ElevationMeters.HasValue ? $"{city.ElevationMeters} m" : "-")</td>
                                <td class="text-center">
                                    @if (city.IsCapital == true)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info text-dark">
                                        @city.Landmarks.Count
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-info me-1" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>