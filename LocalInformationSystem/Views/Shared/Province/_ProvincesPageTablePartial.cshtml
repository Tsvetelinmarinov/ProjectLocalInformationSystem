@model IEnumerable<ProvinceViewModel>

<div class="card border-0 shadow-sm rounded-3 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th scope="col" class="ps-4 py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Province ID
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Name
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Administrative Center
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Area
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Population
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold">
                            Cities
                        </th>
                        <th scope="col" class="py-3 text-secondary text-uppercase fs-7 fw-bold"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No provinces found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">
                                    @Html.DisplayFor(modelItem => item.ProvinceId)
                                </td>
                                <td class="fw-bold text-dark">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border fw-normal px-2 py-1">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i>
                                        @Html.DisplayFor(modelItem => item.AdministrativeCenter)
                                    </span>
                                </td>
                                <td>
                                    @(item.AreaSqKm.HasValue ? item.AreaSqKm.Value.ToString("N2") + " km²" : "N/A")
                                </td>
                                <td>
                                    @(item.Population.HasValue ? item.Population.Value.ToString("N0") : "N/A")
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-3">
                                        @(item.Cities?.Count ?? 0) cities
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-info me-1" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-warning me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="" asp-route-id="" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>