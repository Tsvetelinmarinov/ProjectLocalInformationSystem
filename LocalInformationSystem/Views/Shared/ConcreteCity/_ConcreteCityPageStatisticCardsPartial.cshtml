@model CityViewModel

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary">
                    <i class="bi bi-building fs-2"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Landmarks</div>
                    <div class="fs-4 fw-bold text-dark">@Model.Landmarks.Count</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success">
                    <i class="bi bi-graph-up-arrow fs-2"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Elevation</div>
                    <div class="fs-4 fw-bold text-dark">
                        @(Model.ElevationMeters.HasValue ? $"{Model.ElevationMeters:N2}" : "N/A")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 p-3">
            <div class="card-body d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3 text-info">
                    <i class="bi bi-people fs-2"></i>
                </div>
                <div>
                    <div class="text-muted small text-uppercase fw-semibold">Population</div>
                    <div class="fs-4 fw-bold text-dark">
                        @(Model.Population.HasValue ? $"{Model.Population:N0}" : "N/A")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>