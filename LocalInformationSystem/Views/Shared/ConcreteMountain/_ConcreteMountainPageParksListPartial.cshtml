@model MountainViewModel

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 px-4 border-bottom-0">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-landmark me-2 text-primary"></i>Parks
            </h5>
            <span class="badge bg-secondary rounded-pill px-3 py-2">Total: @Model.Parks.Count</span>
        </div>
        <div class="mt-3">
            <a class="btn btn-sm btn-success rounded-pill px-3 me-2" asp-controller="Mountains" asp-action="AddPark" asp-route-mountainId="@Model.MountainId">
                <i class="bi bi-plus-lg me-1"></i>Add Park
            </a>
        </div>
    </div>

    @if (Model.Parks != null && Model.Parks.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4">Park Name</th>
                        <th scope="col" class="text-end pe-4"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var park in Model.Parks)
                    {
                        <tr>
                            <td class="ps-4 fw-medium text-dark">
                                <i class="bi bi-dot text-primary fs-4 me-1"></i>
                                @park.Name
                            </td>
                            <td class="text-end pe-4">
                                <a asp-controller="Mountains" asp-action="ParkDetails" asp-route-id="@park.ParkId" class="btn btn-sm btn-light rounded-pill border px-3 me-2">
                                    View Details
                                </a>
                                <a class="btn btn-sm btn-danger rounded-pill px-3" asp-controller="Mountains" asp-action="DeletePark" asp-route-id="@park.ParkId">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-building-x fs-1 text-muted d-block mb-2"></i>
            <p class="text-muted mb-0">No parks found for this province.</p>
        </div>
    }
</div>