@model RiverViewModel

@{
    ViewData["Title"] = $"Edit River {this.Model.Name}";
}

<div class="container mb-5">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm p-4">
                <h3 class="card-title mb-4">Edit River Information</h3>
                <form asp-action="EditRiver" method="post">
                    <input type="hidden" asp-for="RiverId"/>
                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control"/>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="LengthKm" class="form-label"></label>
                        <input asp-for="LengthKm" class="form-control"/>
                        <span asp-validation-for="LengthKm" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Outflow" class="form-label"></label>
                        <input asp-for="Outflow" class="form-control"/>
                        <span asp-validation-for="Outflow" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}